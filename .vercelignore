# Secrets / config locale — les variables sont définies dans Vercel (env vars)
.env
.env.*
.envrc

# Environnements Python
.venv/
venv/
ENV/

# Données locales non servies en prod (uploads Cloudinary, DB locale)
media/
db.sqlite3
db.sqlite3-journal
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Archives & outils locaux
*.zip
get-pip.py
ngrok.exe
ngrok.zip
ngrok.log
tmp/
.agents/
.claude/
.git/
.vscode/
.idea/

# NB : staticfiles/ (sortie de collectstatic local) DOIT être téléversé :
# c'est lui qui alimente la route /static/ -> /staticfiles/ — ne pas l'ignorer.
# Exécuter `python manage.py collectstatic --noinput` localement avant chaque
déploiement.  staticfiles_build/ (copie faite sur Vercel par build.sh) est
# ignorée : les builders legacy ne la montent pas dans l'output servi.

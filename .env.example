# ═══════════════════════════════════════
#  DJANGO
# ═══════════════════════════════════════
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True

# ═══════════════════════════════════════
#  NEON POSTGRES (Base de données)
# ═══════════════════════════════════════
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# ⚠️ N'AJOUTEZ PAS channel_binding=require — ça casse la connexion sur Vercel

# ═══════════════════════════════════════
#  CLOUDINARY (Upload direct côté client)
#  1. Créer un compte gratuit sur https://console.cloudinary.com
#  2. Aller dans Settings → API Keys → copier les valeurs ci-dessous
#  3. Aller dans Settings → Upload → créer un "Upload Preset" NON SIGNÉ
#     (unsigned) nommé "geomanager_uploads"
# ═══════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=geomanager_uploads
# API key/secret optionnels — uniquement si upload signé (non recommandé)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════
#  MAISHAPAY (Paiements mobiles)
# ═══════════════════════════════════════
MAISHAPAY_API_URL=https://marchand.maishapay.online/api/payment/rest/vers1.0/merchant
MAISHAPAY_API_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_MERCHANT_ID=
MAISHAPAY_CALLBACK_URL=
MAISHAPAY_DEMO_MODE=True

# ═══════════════════════════════════════
#  EMAIL (optionnel)
# ═══════════════════════════════════════
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Geomanager <noreply@geomanager.com>
